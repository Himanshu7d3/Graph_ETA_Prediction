    "risk_tier_dict = audit_df.set_index(\"hub_id\")[\"risk_tier\"].to_dict()\n",
    "df[\"risk_profile\"]       = df[\"source_center_raw\"].map(risk_tier_dict).fillna(\"Low Risk\").apply(lambda r: f\"{r} Hub\")\n",
    "\n",
    "# Update df_train slice\n",
    "df_train[\"route_type_str\"] = df.loc[train_idx, \"route_type_str\"]\n",
