   "source": [
    "# 80 / 10 / 10 Train, Validation, Test Split by trip_uuid\n",
    "trip_ids = df[\"trip_uuid\"].drop_duplicates().to_numpy()\n",
    "train_trips, temp_trips = train_test_split(\n",
    "    trip_ids,\n",
    "    test_size=0.20,\n",
    "    random_state=26\n",
    ")\n",
    "val_trips, test_trips = train_test_split(\n",
    "    temp_trips,\n",
    "    test_size=0.50,\n",
    "    random_state=26\n",
    ")\n",
    "\n",
    "df_train = df[df[\"trip_uuid\"].isin(train_trips)].copy()\n",
    "df_val   = df[df[\"trip_uuid\"].isin(val_trips)].copy()\n",
    "df_test  = df[df[\"trip_uuid\"].isin(test_trips)].copy()\n",
    "\n",
    "train_idx = df_train.index\n",
    "val_idx   = df_val.index\n",
    "test_idx  = df_test.index\n",
    "\n",
    "print(f\"Split breakdown: Train trips={len(train_trips):,} ({len(df_train):,} rows), Val trips={len(val_trips):,} ({len(df_val):,} rows), Test trips={len(test_trips):,} ({len(df_test):,} rows)\")\n"
   ]
  },
