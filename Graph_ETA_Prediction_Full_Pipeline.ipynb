    "# Counterfactual SLA Recovery: If top 5 bottleneck hubs improve to the low-risk benchmark breach rate\n",
    "network_benchmark_breach_rate = (\n",
    "    audit_df[audit_df[\"risk_tier\"] == \"Low Risk\"][\"total_sla_breach_trips\"].sum() /\n",
    "    np.maximum(audit_df[audit_df[\"risk_tier\"] == \"Low Risk\"][\"total_hub_trips\"].sum(), 1)\n",
    ")\n",
    "\n",
    "top5_for_recovery = audit_df.head(5)\n",
    "breaches_recovered = 0\n",
    "for _, hub in top5_for_recovery.iterrows():\n",
    "    actual_hub_breaches = hub[\"total_sla_breach_trips\"]\n",
    "    total_trips = hub[\"total_hub_trips\"]\n",
    "    expected_breaches_after_upgrade = total_trips * network_benchmark_breach_rate\n",
    "    breaches_recovered += max(0, actual_hub_breaches - expected_breaches_after_upgrade)\n",
    "\n",
    "total_current_breaches = df_train[\"is_sla_breach\"].sum()\n",
    "reduction_pct = (breaches_recovered / total_current_breaches * 100) if total_current_breaches > 0 else 0\n",
    "revenue_recovered = breaches_recovered * PENALTY_PER_BREACH_RS\n",
    "\n",
    "print(\"ESTIMATED IMPACT OF UPGRADING TOP 5 BOTTLENECK HUBS\")\n",
    "print(f\"  Benchmark Low-Risk Hub Breach Rate: {network_benchmark_breach_rate*100:.1f}%\")\n",
    "print(f\"  SLA Breaches Recoverable (Top 5)  : {int(breaches_recovered):,}\")\n",
    "print(f\"  Reduction in Late Deliveries      : {reduction_pct:.2f}%\")\n",
    "print(f\"  Revenue Recoverable               : Rs {revenue_recovered:,.0f}\")\n"
   ]
